# ======================================================================
# 智能工单售后 Agent — 环境变量样例
# 用法：cp .env.example .env  然后按需修改
# 注意：.env 已加入 .gitignore，不要把真实 key 提交到版本库
# ======================================================================

# ----------------------------------------------------------------------
# 1. 大模型配置
# ----------------------------------------------------------------------
# 本项目 src/config.py 读取的变量名是 MODEL_*（Phase 1 起沿用），
# 而 Phase 2 需求书给的命名是 DEEPSEEK_*。两套都支持：
# src/api/settings.py 会把 DEEPSEEK_* 自动回填到 MODEL_*，
# 所以下面两组**只填其中一组**即可（两组都填时以 MODEL_* 为准）。
MODEL_API_KEY=sk-your-key-here
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash

# 等价别名（可选，填了上面就不用填）
# DEEPSEEK_API_KEY=sk-your-key-here
# DEEPSEEK_MODEL=deepseek-v4-flash

# 会话记忆 TTL（秒）：同一会话多久没说话就丢弃上下文
SESSION_TTL_SECONDS=1800

# ----------------------------------------------------------------------
# 2. 数据库
# ----------------------------------------------------------------------
# 业务数据（订单/库存/退货）+ 运行台账（任务/工具流水）共用的一个 SQLite 库。
#
# DATABASE_URL —— 标准连接串写法，推荐用这个（默认值见下方）。
#   支持 sqlite:/// 形式。相对路径按**项目根目录**解析（而不是进程启动目录），
#   所以从任何地方启动都能连到同一个库。
#   迁移数据：python scripts/migrate_csv_to_db.py --reset
DATABASE_URL=sqlite:///./data/agent_operations.db

# AGENT_DB_PATH —— 直接给"库文件路径"（不走 URL 解析）。
#   优先级高于 DATABASE_URL（测试用它把库重定向到临时目录）。
#   不填时默认：<项目根>/data/agent_operations.db
#   注意：这是路径不是 URL，别写成 sqlite:///...
# AGENT_DB_PATH=data/agent_operations.db

# 库文件不存在时的行为：数据层自动降级回读 CSV（data/mock/），服务照常可用。
# 想强制走 CSV 对比性能，直接把 DATABASE_URL 指向一个不存在的路径即可。

# ----------------------------------------------------------------------
# 3. Web 服务（Phase 2）
# ----------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=1.0.0
# 开发期改代码自动重启；生产务必保持 false（reload 会多起一个监视进程）
API_RELOAD=false
API_LOG_LEVEL=info

# 后台 Worker 协程数。
# 注意：当前"真正执行 Agent"的阶段是串行的（全局单例 + SQLite 单文件所限），
# 详见 src/api/worker.py 顶部说明。这个值预留给后续接入 PostgreSQL 后水平扩容。
WORKERS=1
MAX_QUEUE_SIZE=1000

# 单个上传文件大小上限（字节）。默认 10MB = 10485760
MAX_UPLOAD_SIZE=10485760
# 允许的上传扩展名（逗号分隔）
ALLOWED_UPLOAD_SUFFIXES=.xlsx,.xls,.csv
# 上传文件临时目录；留空 = 系统临时目录下的 ai-ticket-agent/
# UPLOAD_TEMP_DIR=
# 设为 true 时任务结束不删临时文件（仅排查问题用，会导致磁盘堆积）
KEEP_UPLOAD_FILES=false
# 是否允许"上传的订单文件真正参与本次查询"；false 时上传只做接收与留痕
USE_UPLOADED_DATASET=true

# 强制 mock：不调真实大模型（离线演示 / 自动化测试）。生产请保持 false
AGENT_FORCE_MOCK=false

# ----------------------------------------------------------------------
# 3.5 接口鉴权（任务接口）
# ----------------------------------------------------------------------
# 任务接口（/api/v1/tasks/*）的 Bearer Token。
# 这些接口能读到客户姓名、订单号、金额，还能提交/取消任务、翻全量历史，
# 所以**生产环境必须设置**。留空 = 不鉴权，服务启动时会打一条 WARNING。
# 调用方式：Authorization: Bearer <这里填的值>
# /health 与 /metrics 免鉴权（docker healthcheck 与监控探针不会带 Token）。
API_AUTH_TOKEN=

# ----------------------------------------------------------------------
# 4. RAG（历史工单案例检索）
# ----------------------------------------------------------------------
# 让 Agent 处理新工单时检索历史相似案例，把 top-k 条注入 system prompt。
# 实现基于 SQLite 内建的 FTS5 全文检索（src/memory/fts_store.py），
# **零新增第三方依赖**，不需要 chromadb / torch / 模型文件，离线开箱可用。
# 这是"增强项"：置为 false 时行为与加 RAG 之前完全一致。
# SQLite 不支持 FTS5 或库不可写时，会自动降级为规则版（只打 WARNING，
# 不影响 Agent 正常处理工单）。
RAG_ENABLED=true

# 注入 prompt 的历史案例条数（建议 2~3，太多会挤占正文上下文）
RAG_TOP_K=2

# 说明：案例索引与业务数据**共用同一个库文件**（data/agent_operations.db），
# 无需额外配置路径；表名 ticket_cases，不存在时自动创建。

# ----------------------------------------------------------------------
# 5. 退货风险（业务规则）
# ----------------------------------------------------------------------
# 让 Agent 处理工单前先看客户的退货历史：退得太凶就不许自动处理，转人工。
# 规则见 src/agent.py 的 TicketAgent._check_return_risk，文档见 README。
# 这是"增强项"：置为 false 时所有客户都走正常流程，无任何退货检查。
# 仅在 SQLite 数据源上生效；CSV 降级模式下自动跳过（只打 INFO 日志）。
RETURN_RISK_ENABLED=true

# 客户退货率阈值：达到即**升级人工**（跳过自动建议流程）。
# 口径 = 该客户近 30 天订单中"退过货的订单"占比（按订单去重）。
# ⚠️ 0.4 是需求给的默认值，**不是普适常数**，必须按真实数据分布标定。
#    演示数据已用 scripts/rescale_mock_timeline.py 重标定过
#    （订单铺开在最近 180 天、整体退货率约 12%），此时约 7% 的客户会被判升级 ——
#    规则既有区分度，又不至于一刀切。
#    换一份数据就要重新标定：若整体退货率高达 87%，这个阈值会把几乎所有客户升级，
#    Agent 的自动处理能力就形同虚设。
RETURN_RISK_THRESHOLD_CUSTOMER=0.4

# 单商品退货率阈值：达到即在建议里提示"该商品近期退货率较高，建议验货"。
# 口径 = 含该 SKU 的近 30 天订单中"退过货的订单"占比。
RETURN_RISK_THRESHOLD_SKU=0.3

# 最小退货次数：客户近 30 天退货订单数达到该值即标记"高风险"（率未达标时兜底）。
# 同一订单退多件只算一次（按订单去重），避免次数虚高。
RETURN_RISK_MIN_COUNT=2

# 说明：非法的数字写法（如把 0.4 写成 "0,4"）不会导致启动失败，
# 会自动回退到默认值并打一条 WARNING。

# CORS 允许的来源，逗号分隔；* 表示任意来源（方便接前端）
CORS_ORIGINS=*
