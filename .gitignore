# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/

# 虚拟环境
.venv/
venv/
env/

# 环境变量
# 说明：.env.* 会连 .env.example 一起忽略掉，所以必须显式放行它 ——
# 样例文件是要进版本库的（新同学照着它建 .env），真实 .env 才不能进。
.env
.env.*
!.env.example

# 日志
logs/
*.log

# 数据生成产物（保留 mock 源数据）
data/*.xlsx
data/*.csv
!data/mock/
# 演示数据重标定前的原始备份（见 scripts/rescale_mock_timeline.py）
data/mock/*.orig.bak

# 持久化数据库（Phase 1）：本地运行产生的审计留痕，不入版本库
data/agent_operations.db
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# 测试/工具缓存
.pytest_cache/
.ruff_cache/
.mypy_cache/
# 测试运行产物（CI 与本地按 CI 命令跑都会生成）
.coverage
coverage.xml
test-results/

# 运行产物
outputs/
*.tmp
*.temp

# Web 服务（Phase 2）：上传文件默认落在系统临时目录，不占项目空间；
# 这里兜住"有人显式把 UPLOAD_TEMP_DIR 指到项目内"的情况。
uploads/
.uploads/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
